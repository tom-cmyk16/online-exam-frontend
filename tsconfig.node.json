{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"], // Added 'DOM' for browser environment support
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true, // Corrected from "erasableSyntaxOnly"
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true, // Corrected from "noUncheckedSideEffectImports"
    "esModuleInterop": true // Recommended addition
  },
  "include": ["vite.config.ts"]
}